<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <link rel="stylesheet" href="/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/fontawesome/css/all.min.css">
    <link rel="stylesheet" href="/content/app.css">
</head>
<body>

    <%- include('../partials/header') %>

    <main class="container my-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1>My Assignments</h1>
                <p class="text-muted">View and manage your upcoming assignments.</p>
            </div>

            <a href="/assignments/create" class="btn btn-primary">
                <i class="fa-solid fa-plus"></i> Create Assignment
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">

                <% if (assignments.length === 0) { %>

                    <p class="text-center text-muted mb-0">
                        No assignments have been added yet.
                    </p>

                <% } else { %>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">

                            <thead>
                                <tr>
                                    <th>Assignment</th>
                                    <th>Course</th>
                                    <th>Due Date</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% assignments.forEach(function(assignment) { %>
                                    <tr>
                                        <td><%= assignment.assignmentName %></td>
                                        <td><%= assignment.course %></td>
                                        <td><%= new Date(assignment.dueDate).toLocaleDateString() %></td>
                                        <td><%= assignment.status %></td>
                                        <td>
                                            <!-- Edit assignment button -->
                                            <a href="/assignments/edit/<%= assignment._id %>" class="btn btn-sm btn-primary">
                                                <i class="fa-solid fa-pen"></i> Edit
                                            </a>

                                            <!-- Delete assignment button with confirmation -->
                                            <form action="/assignments/delete/<%= assignment._id %>" method="POST" style="display: inline;"
                                                  onsubmit="return confirm('Are you sure you want to delete this assignment?');">

                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="fa-solid fa-trash"></i> Delete
                                                </button>

                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>

                        </table>
                    </div>

                <% } %>

            </div>
        </div>

    </main>

    <%- include('../partials/footer') %>

    <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
